TIMEOUT, ATTEMPTS, SLEEPTIME, REQUEST_INTERVAL = 30.0, 3, 1.0, 1.0
MAX_RETRY_WAIT = 60.0
MAX_RESPONSE_BYTES = 5 * 1024 * 1024
RETRYABLE_HTTP = {408, 429, 500, 502, 503, 504}
PROBLEM_STATUSES = {"lookup_failed", "invalid_response", "gene_id_mismatch",
    "ambiguous_local_records", "species_mismatch", "missing_local_gene_id",
    "local_record_replaced",}

# Exact field names from the user's local /summary example.
LOCAL_FIELDS = (
    "ncbi_gene_id", "official_symbol", "description", "status",
    "current_gene_id", "chromosome", "map_location", "organism_scientific",
    "organism_common", "other_aliases", "other_designations",)
RECORD_NAMES = (
    "Local_Gene_ID", "Local_Official_Symbol", "Local_Official_Name",
    "Local_Status_Field", "Local_Current_Gene_ID", "Local_Chromosome",
    "Local_Map_Location", "Local_Organism_Scientific", "Local_Organism_Common",
    "Local_Other_Aliases", "Local_Other_Designations",)
LOCAL_TO_COLUMN = dict(zip(LOCAL_FIELDS, RECORD_NAMES))
COMPARISONS = (
    ("Symbol", "Official_Symbol", "official_symbol"),
    ("Name", "Official_Name", "description"),
    ("Map_Location", "Map_Location", "map_location"),
    ("Aliases", "Other_Aliases", "other_aliases"),)
KEY_COLUMNS = ["Dataset", "Input_Row", "Query_Symbol", "Gene_ID"]
COMPARISON_COLUMNS = KEY_COLUMNS + [
    "Official_Symbol", "Resolution_Status", "Resolution_Note", "Same_Gene_Note",
    "NCBI_Official_Name", "NCBI_Map_Location", "NCBI_Other_Aliases",
    "Local_Query", "Local_Status", "Local_Note", "Local_Record_Count",
    "Local_Candidate_Gene_IDs", "Selected_Record_Number",] + list(RECORD_NAMES) + ["Gene_ID_Comparison"] + [
    name + "_Comparison" for name, _, _ in COMPARISONS] + ["Comparison_Status", "Differences", "Missing_Fields", "Retrieved_UTC", "Source_URL"]
TSV_COLUMNS = KEY_COLUMNS + [  # The TSV; the JSON keeps every comparison field.
    "Official_Symbol", "Local_Query", "Local_Status", "Local_Note", "Local_Record_Count",
    "Local_Gene_ID", "Comparison_Status", "Differences", "Missing_Fields", "Source_URL"]
