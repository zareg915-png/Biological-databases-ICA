"""Part 4: cross-check Part 1's NCBI annotations against the course's local API.

Input:  OP1_data/part1_data/final_data/<dataset>/ncbi_gene_summary2.tsv (Part 1)
Output: OP1_data/part4_data/<dataset>/
  local_ncbi_comparisons.tsv  one row per Part 1 input: the local API outcome
                              (Local_Status), the field comparisons and an
                              overall Comparison_Status
  local_api_results.json      {"candidate_records": every record the local API
                              returned, linked to its input row, with the one
                              used for the comparison marked as Selected}

Each resolved input's official symbol is sent to the local /summary endpoint.
A local record is only compared with NCBI when it carries the same NCBI Gene
ID as Part 1, belongs to Homo sapiens (or gives no species) and has not been
replaced by another Gene ID. Otherwise Local_Status says why no comparison was
made. The official symbol and the cytogenetic map location are then compared.

all_sql_loads.py loads the TSV as p4_local_ncbi_comparisons and the JSON's
candidate_records as p4_local_api_records; make_html_tables.py reads
Comparison_Status, Local_Note and Differences.

The API URL can be changed with BDB_LOCAL_API_BASE_URL. Shared helpers and
the run() entry point come from p1_basic_anno.py (same folder).
"""
import json
import os
from functools import cache
import importlib.util, sys
from pathlib import Path
CODE = Path(__file__).resolve().parents[1]   # the data_ret_script folder

def _load(name, relative_path):
    """Import another part's script under the module name this code expects."""
    spec = importlib.util.spec_from_file_location(name, CODE / relative_path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)

_load("p1_basic_anno", "part1/final_script_run_for_both_lists/final_script_for_both_end_res.py")
from p1_basic_anno import API_ERRORS, ServiceError, get_json, part_dir, read_table, run, write_tsv
BASE_URL = os.getenv("BDB_LOCAL_API_BASE_URL", "http://bioinfmsc6.bio.ed.ac.uk:8080").rstrip("/")
# CHANGED in review: the chromosome comparison is replaced by Map_Location
# (Part 1 no longer writes Chromosome), and Comparison_Status and Differences
# are added for the HTML table.
COLUMNS = """Dataset Input_Row Query_Symbol Gene_ID Official_Symbol NCBI_Map_Location Local_Gene_ID
             Local_Official_Symbol Local_Map_Location Local_Status Symbol_Comparison Map_Location_Comparison
             Comparison_Status Differences Local_Note""".split()
# Local API field -> column name for each record in local_api_results.json.
# The fixed order gives every record the same keys, so they load into one
# MySQL table with the same column names as before.
RECORD_FIELDS = {
    "ncbi_gene_id": "Local_Gene_ID", "official_symbol": "Local_Official_Symbol",
    "description": "Local_Official_Name", "status": "Local_Status_Field",
    "current_gene_id": "Local_Current_Gene_ID", "chromosome": "Local_Chromosome",
    "map_location": "Local_Map_Location", "organism_scientific": "Local_Organism_Scientific",
    "organism_common": "Local_Organism_Common", "other_aliases": "Local_Other_Aliases",
    "other_designations": "Local_Other_Designations",
}
# Local_Status values that are expected outcomes rather than problems.
NORMAL = {"matched", "matched_species_not_supplied", "input_not_resolved", "no_records_returned"}


def clean(value):
    """Return a value as text with whitespace collapsed; None becomes ""."""
    return "" if value is None else " ".join(str(value).split())


@cache  # Repeated symbols (e.g. MYC entered three ways) are requested once.
def lookup(symbol):
    """Return the distinct records the local API holds for a gene symbol.

    The API must return a JSON list of record objects, each with at least a
    Gene ID or an official symbol and no error field. Exact duplicate records
    are collapsed; records that differ in any field are kept as separate
    candidates. `sleeptime` is the delay parameter the course API expects.
    """
    response = get_json(BASE_URL + "/summary", {"identifiers": symbol, "sleeptime": 1})
    # The API returns a plain list when it finds the gene, but
    # {"status", "message", "data": []} when it doesn't, so unwrap that case.
    records = response.get("data") if isinstance(response, dict) else response
    if not isinstance(records, list):
        raise ServiceError("Expected a list of records from /summary.")
    unique = {}
    for record in records:
        if (not isinstance(record, dict) or record.get("error") or record.get("errors")
                or not {"ncbi_gene_id", "official_symbol"}.intersection(record)):
            raise ServiceError("The local API returned an invalid gene record.")
        unique[json.dumps(record, sort_keys=True)] = record
    return list(unique.values())


def compare(left, right):
    """Compare two cleaned values: "match", "different", or "missing" if either is blank."""
    if not left or not right:
        return "missing"
    return "match" if left == right else "different"


def check(source, row):
    """Check one Part 1 input against the local API; return (Local_Status, Local_Note).

    Fills the Local_* and comparison columns of `row` as far as the checks get.
    The records returned are stored in row["_records"] (and the one used in
    row["_selected"]) for the JSON output; these keys are not written to the TSV.
    """
    if source["Resolution_Status"] != "resolved":
        return "input_not_resolved", source.get("Resolution_Note", "")
    records = lookup(source["Official_Symbol"])
    row["_records"] = records
    if not records:
        return "no_records_returned", "No local record for this symbol."
    # Select the record by Gene ID; a single record is still checked below
    # even if its Gene ID differs, so the mismatch can be reported.
    matches = [r for r in records if clean(r.get("ncbi_gene_id")) == source["Gene_ID"]]
    if len(matches) > 1 or (not matches and len(records) > 1):
        return "ambiguous_local_records", "No unique matching local record."
    record = (matches or records)[0]
    row["_selected"] = record
    gid = clean(record.get("ncbi_gene_id"))
    row.update(Local_Gene_ID=gid, Local_Official_Symbol=clean(record.get("official_symbol")),
               Local_Map_Location=clean(record.get("map_location")))
    if not gid:
        return "missing_local_gene_id", "The local record has no Gene ID."
    if not matches:
        return "gene_id_mismatch", "Local Gene ID differs from Part 1."
    species = clean(record.get("organism_scientific")).casefold()
    if species and species != "homo sapiens":
        return "species_mismatch", "The local record belongs to another species."
    if clean(record.get("current_gene_id")) not in ("", "0", gid):
        return "local_record_replaced", "The record links to a different current Gene ID."
    # Same gene confirmed: compare the annotation fields.
    row["Symbol_Comparison"] = compare(clean(source["Official_Symbol"]), row["Local_Official_Symbol"])
    row["Map_Location_Comparison"] = compare(row["NCBI_Map_Location"], row["Local_Map_Location"])
    outcomes = {"Symbol": row["Symbol_Comparison"], "Map_Location": row["Map_Location_Comparison"]}
    row["Differences"] = ";".join(name for name, outcome in outcomes.items() if outcome == "different")
    row["Comparison_Status"] = ("differences_detected" if row["Differences"] else
                                "agreement_with_missing_fields" if "missing" in outcomes.values() else
                                "all_fields_agree")
    if not species:
        return "matched_species_not_supplied", "Gene ID matched. Local species was missing."
    return "matched", ""


def candidate_records(row):
    """Return one JSON record per local API record returned for this input row."""
    selected = row.get("_selected")
    return [{"Input_Row": row["Input_Row"], "Query_Symbol": row["Query_Symbol"], "Gene_ID": row["Gene_ID"],
             "Local_Query": row["Official_Symbol"], "Record_Number": number,
             "Matches_Part1_Gene_ID": clean(record.get("ncbi_gene_id")) == row["Gene_ID"],
             "Selected": record is selected,
             **{column: clean(record.get(field)) for field, column in RECORD_FIELDS.items()}}
            for number, record in enumerate(row.get("_records", []), 1)]


def process(data_root, dataset):
    """Check every Part 1 input of one dataset and write the TSV and JSON outputs.

    Returns True (the run exits with code 2) if any input could not be
    checked cleanly (lookup failure, ambiguity, mismatch or replaced record),
    or if Part 1 recorded a failed lookup.
    """
    # plain=True: Part 1 writes unquoted TSV, so quotes are literal text.
    inputs = read_table(part_dir(data_root, 1, dataset) / "ncbi_gene_summary2.tsv", plain=True)
    rows = []
    for number, source in enumerate(inputs, 1):
        row = {k: source[k] for k in ("Query_Symbol", "Gene_ID", "Official_Symbol")}
        # Comparison_Status stays "not_assessed" unless the same gene is confirmed.
        row.update(Dataset=dataset, Input_Row=number, NCBI_Map_Location=clean(source.get("Map_Location")),
                   Comparison_Status="not_assessed")
        try:
            row["Local_Status"], row["Local_Note"] = check(source, row)
        except API_ERRORS as error:
            row.update(Local_Status="lookup_failed", Local_Note=str(error))
        rows.append(row)
    folder = part_dir(data_root, 4, dataset)
    write_tsv(folder / "local_ncbi_comparisons.tsv", COLUMNS, rows)
    records = [record for row in rows for record in candidate_records(row)]
    (folder / "local_api_results.json").write_text(
        json.dumps({"candidate_records": records}, indent=2, ensure_ascii=False), encoding="utf-8")
    failed = any(row["Local_Status"] not in NORMAL for row in rows) or any(s["Resolution_Status"] == "failed" for s in inputs)
    if not failed:
        # Remove the output of an earlier script version so it is not mistaken for current data.
        (folder / "local_api_records.tsv").unlink(missing_ok=True)
    print(f"Part 4 {dataset}: {len(rows)} local validation outcomes, {len(records)} local records saved.")
    return failed


if __name__ == "__main__":
    run(process)
