# Editable configuration: matches the saved Part 1/2 loader and Part 3 paths.
PROJECT_ROOT = Path(os.environ.get("BDB_PROJECT_ROOT", "~/BDB_ICA")).expanduser()
PART1_ROOT = Path(os.environ.get( "BDB_PART1_OUTPUT_DIR", str(PROJECT_ROOT / "OP1_data/part1_data/final_data"))).expanduser()
OUTPUT_ROOT = Path(os.environ.get("BDB_PART4_OUTPUT_DIR", str(PROJECT_ROOT / "OP1_data/part4_data"))).expanduser()
