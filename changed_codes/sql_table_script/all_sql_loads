def column_type(name):
    if name == "Dataset":
        return "VARCHAR(20) NOT NULL"
    if name == "Species":
        return "VARCHAR(10) NOT NULL"
    if name in BOOLEAN_COLUMNS:
        return "TINYINT UNSIGNED"
    if name in INTEGER_COLUMNS or name.endswith("_Count"):
        return "INT UNSIGNED" + (" NOT NULL" if name in {"Input_Row", "Record_Number"} else "")
    if name in FLOAT_COLUMNS or name.endswith("_Jaccard"):
        return "DOUBLE"
    if name in ID_COLUMNS:
        return "VARCHAR(20)"
    if name == "UniProt_Accession":
        return "VARCHAR(32) NOT NULL"
    if name in {"Tissue_ID", "Bgee_Gene_ID"}:
        return "VARCHAR(64) NOT NULL"
    # Preserve long summaries and evidence JSON without truncating them.
    return "LONGTEXT"


def convert_cell(name, value):
    if value == "":
        return None
    if name in ID_COLUMNS:
        if not re.fullmatch(r"[1-9][0-9]{0,19}", value):
            raise ValueError(f"Invalid {name}.")
    kind = column_type(name)
    if name in BOOLEAN_COLUMNS:
        mapping = {"0": 0, "1": 1, "false": 0, "true": 1}
        if value.lower() not in mapping:
            raise ValueError(f"Invalid boolean {name}.")
        return mapping[value.lower()]
    if kind.startswith("INT"):
        if not re.fullmatch(r"[0-9]+", value) or int(value) > 4294967295:
            raise ValueError(f"Invalid non-negative integer {name}.")
        number = int(value)
        if name in INTEGER_COLUMNS and number == 0:
            raise ValueError(f"{name} must be positive when present.")
        return number
    if kind == "DOUBLE":
        number = float(value)
        if not math.isfinite(number):
            raise ValueError(f"Non-finite {name}.")
        if (name.endswith("_Jaccard") or name.endswith("FDR")
                or name == "Expression_Call_Agreement") and not 0 <= number <= 1:
            raise ValueError(f"{name} is outside [0, 1].")
        return number
    if name.endswith("_JSON") or name in JSON_COLUMNS or name.endswith(
        ("_Shared_IDs", "_Human_Only_IDs", "_Mouse_Only_IDs")
    ):
        json.loads(value)  # Validate while preserving the original JSON text.
    if name == "Retrieved_UTC":
        if datetime.fromisoformat(value).utcoffset() is None:
            raise ValueError("Retrieved_UTC needs a timezone.")
    length = re.match(r"VARCHAR\((\d+)\)", kind)
    if length and len(value) > int(length[1]):
        raise ValueError(f"{name} exceeds its column length.")
    return value


def read_extra_tables(part3_dir, part4_dir):
    tables = {}
    for table, (part, filename, columns) in EXTRA_FILES.items():
        tables[table] = {}
        for dataset in DATASETS:
            path = (part3_dir if part == 3 else part4_dir) / dataset / filename
            rows = []
            with path.open(encoding="utf-8-sig", newline="") as stream:
                reader = csv.DictReader(stream, delimiter="\t", strict=True)
                if reader.fieldnames != columns:
                    raise ValueError(f"Unexpected columns: {path}")
                for row in reader:
                    if None in row or any(value is None for value in row.values()):
                        raise ValueError(f"Wrong field count: {path}:{reader.line_num}")
                    if row["Dataset"] != dataset:
                        raise ValueError(f"Dataset differs from its folder: {path}:{reader.line_num}")
                    try:
                        rows.append({name: convert_cell(name, row[name]) for name in columns})
                    except (ValueError, TypeError) as error:
                        raise ValueError(f"{path}:{reader.line_num}: {error}") from error
            keys = [tuple(row[name] for name in KEYS[table]) for row in rows]
            if len(keys) != len(set(keys)):
                raise ValueError(f"Duplicate record keys: {path}")
            tables[table][dataset] = rows
    return tables


def require(condition, message):
    if not condition:
        raise ValueError(message)


def pair_key(row):
    return row["Input_Row"], row["Human_Gene_ID"], row["Mouse_Gene_ID"]


def validate_relationships(part1, part2, extra):
    for dataset in DATASETS:
        originals = {number: row for number, row in enumerate(part1[dataset], 1)}
        compare_with_part1(dataset, part1_originals(part1[dataset]), part2[dataset])
        pairs = {pair_key(row): row for row in part2[dataset]}
        summaries = extra["p3_pair_summary"][dataset]
        require({pair_key(row) for row in summaries} == set(pairs),
                f"{dataset}: Part 3 pair outcomes differ from Part 2.")
        for row in summaries:
            original, pair = originals[row["Input_Row"]], pairs[pair_key(row)]
            for name in ("Resolution_Status", "Resolution_Note", "Same_Gene_Note"):
                require((row[name] or "") == (original[name] or ""),
                        f"{dataset}: Part 3 {name} differs from Part 1.")
            require(row["Query_Symbol"] == original["Query_Symbol"]
                    and row["Mapping_Status"] == pair["Mapping_Status"],
                    f"{dataset}: Part 3 input/mapping mismatch.")
        for row in extra["p3_tissue_comparison"][dataset]:
            require(pair_key(row) in pairs and row["Mouse_Gene_ID"] is not None,
                    f"{dataset}: Tissue comparison lacks its mapped pair.")
            require(row["Query_Symbol"] == originals[row["Input_Row"]]["Query_Symbol"],
                    f"{dataset}: Tissue input label differs from Part 1.")
        expected_genes = {("human", row["Gene_ID"]) for row in originals.values() if row["Gene_ID"]}
        expected_genes.update(("mouse", row["Mouse_Gene_ID"]) for row in part2[dataset]
                              if row["Mouse_Gene_ID"])
        gene_rows = extra["p3_gene_status"][dataset]
        observed_genes = {(row["Species"], row["Gene_ID"]) for row in gene_rows}
        require(observed_genes == expected_genes, f"{dataset}: Part 3 gene coverage differs from Parts 1/2.")
        for table in ("p3_gene_status", "p3_uniprot", "p3_bgee_calls"):
            for row in extra[table][dataset]:
                require((row["Species"], row["Gene_ID"]) in expected_genes
                        and row["Tax_ID"] == {"human": "9606", "mouse": "10090"}.get(row["Species"]),
                        f"{dataset}: {table} has an unexpected gene/species.")
        comparisons = extra["p4_local_ncbi_comparisons"][dataset]
        require({row["Input_Row"] for row in comparisons} == set(originals),
                f"{dataset}: Part 4 must retain every Part 1 input.")
        records = defaultdict(list)
        for row in extra["p4_local_api_records"][dataset]:
            require(row["Input_Row"] in originals, f"{dataset}: Unknown local record input.")
            records[row["Input_Row"]].append(row)
        for row in comparisons:
            original = originals[row["Input_Row"]]
            require(all((row[name] or "") == (original[name] or "") for name in (
                "Query_Symbol", "Gene_ID", "Official_Symbol", "Resolution_Status",
                "Resolution_Note", "Same_Gene_Note")), f"{dataset}: Part 4 differs from Part 1.")
            group = records[row["Input_Row"]]
            count = row["Local_Record_Count"]
            require((count is None and not group) or count == len(group),
                    f"{dataset}: Local record count mismatch.")
            for record in group:
                require(record["Query_Symbol"] == row["Query_Symbol"]
                        and record["Gene_ID"] == row["Gene_ID"], f"{dataset}: Local record identity mismatch.")
            selected = [record for record in group if record["Selected"] == 1]
            number = row["Selected_Record_Number"]
            require(len(selected) == (1 if number is not None else 0),
                    f"{dataset}: Local selected record count mismatch.")
            if selected:
                require(selected[0]["Record_Number"] == number
                        and selected[0]["Local_Gene_ID"] == row["Local_Gene_ID"],
                        f"{dataset}: Local selected record differs from the comparison.")


def table_columns(table):
    if table == PART1_TABLE_NAME:
        return PART1_DATABASE_COLUMNS
    if table == PART2_TABLE_NAME:
        return PART2_DATABASE_COLUMNS
    return EXTRA_FILES[table][2]


def table_values(table, dataset, prepared):
    if table == PART1_TABLE_NAME:
        return input_values(1, dataset, prepared[table][dataset])
    if table == PART2_TABLE_NAME:
        return input_values(2, dataset, prepared[table][dataset])
    columns = table_columns(table)
    return [tuple(row[name] for name in columns) for row in prepared[table][dataset]]


def create_extra_sql(table, collation):
    require(re.fullmatch(r"utf8mb4_[A-Za-z0-9_]+", collation), "Unsupported table collation.")
    columns = table_columns(table)
    fields = ["`Row_ID` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY"]
    fields.extend(f"`{name}` {column_type(name)}" for name in columns)
    keys = ", ".join(f"`{name}`" for name in KEYS[table])
    fields.append(f"UNIQUE KEY `idx_record_key` ({keys})")
    if "Input_Row" in columns:
        fields.append("KEY `idx_dataset_input` (`Dataset`, `Input_Row`)")
        fields.append(f"CONSTRAINT `fk_{table}_input` FOREIGN KEY (`Dataset`, `Input_Row`) "
                      "REFERENCES `p1_annotations` (`Dataset`, `Input_Row`)")
    if "Gene_ID" in columns:
        fields.append("KEY `idx_gene_id` (`Gene_ID`)")
    if "Human_Gene_ID" in columns:
        fields.extend(["KEY `idx_human_gene` (`Human_Gene_ID`)",
                       "KEY `idx_mouse_gene` (`Mouse_Gene_ID`)"])
    if table in {"p3_uniprot", "p3_bgee_calls"}:
        fields.append(f"CONSTRAINT `fk_{table}_gene` FOREIGN KEY (`Dataset`, `Species`, `Gene_ID`) "
                      "REFERENCES `p3_gene_status` (`Dataset`, `Species`, `Gene_ID`)")
    return (f"CREATE TABLE IF NOT EXISTS `{table}` (\n  " + ",\n  ".join(fields)
            + f"\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE {collation}")


def prepare_schema(connection, cursor):
    cursor.execute(build_table_sql(1, "utf8mb4_unicode_ci"))
    check_table(cursor, 1)
    ensure_indexes(cursor, 1)
    cursor.execute("SELECT COLLATION_NAME FROM information_schema.COLUMNS "
                   "WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='p1_annotations' AND COLUMN_NAME='Dataset'")
    collation = cursor.fetchone()[0]
    cursor.execute(build_table_sql(2, collation))
    check_table(cursor, 2)
    ensure_indexes(cursor, 2)
    for table in EXTRA_FILES:
        cursor.execute(create_extra_sql(table, collation))
        cursor.execute(f"SHOW COLUMNS FROM `{table}`")
        require([row[0] for row in cursor.fetchall()] == ["Row_ID", *table_columns(table)],
                f"Existing {table} has a different schema; review it before importing.")
        cursor.execute("SELECT ENGINE FROM information_schema.TABLES "
                       "WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME=%s", (table,))
        require(cursor.fetchone()[0].upper() == "INNODB", f"{table} must use InnoDB.")
    connection.commit()  # MySQL DDL commits separately from the data transaction.


def load_and_verify(connection, cursor, prepared):
    connection.start_transaction()
    try:
        # Children are deleted before parents. Other Dataset values are retained.
        for table in reversed(TABLE_NAMES):
            cursor.execute(f"DELETE FROM `{table}` WHERE `Dataset` IN (%s, %s)", DATASETS)
        for table in TABLE_NAMES:
            columns = table_columns(table)
            names = ", ".join(f"`{name}`" for name in columns)
            placeholders = ", ".join(["%s"] * len(columns))
            insert = f"INSERT INTO `{table}` ({names}) VALUES ({placeholders})"
            for dataset in DATASETS:
                expected = table_values(table, dataset, prepared)
                for start in range(0, len(expected), 200):
                    cursor.executemany(insert, expected[start:start + 200])
                cursor.execute(f"SELECT {names} FROM `{table}` WHERE `Dataset`=%s ORDER BY `Row_ID`", (dataset,))
                require(cursor.fetchall() == expected, f"Stored {table}/{dataset} differs from its TSV.")
        check_stored_part1(cursor, prepared[PART2_TABLE_NAME])
        connection.commit()
    except BaseException:
        connection.rollback()
        raise


def export_all(database, username, password, destination, expected_counts, host=None, port=3306):
    program = (os.environ.get("BDB_MYSQLDUMP") or shutil.which("mysqldump")
               or shutil.which("mariadb-dump"))
    require(program, "mysqldump was not found; the tables are loaded but no dump was saved.")
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary_output = None
    try:
        with tempfile.TemporaryDirectory(prefix="bdb_all_dump_") as temporary:
            if password is None and MYSQL_OPTION_FILE.is_file():
                option_file = MYSQL_OPTION_FILE
            else:
                option_file = Path(temporary) / "client.cnf"
                fd = os.open(option_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "w", encoding="utf-8") as stream:
                    stream.write("[client]\n")
                    for key, value in (("user", username), ("password", password or ""),
                                       ("socket", MYSQL_SOCKET)):
                        stream.write(f"{key}={quote_option_value(value)}\n")
            help_result = subprocess.run([program, "--no-defaults", "--help"],
                                         capture_output=True, text=True, timeout=20, check=False)
            command = [program, f"--defaults-file={option_file}", "--single-transaction",
                       "--skip-lock-tables", "--skip-add-locks", "--no-tablespaces",
                       "--skip-comments", "--skip-dump-date", "--skip-extended-insert",
                       "--default-character-set=utf8mb4",
                       "--where=Dataset IN ('development','challenge')", f"--user={username}"]
            if host:
                command.extend([f"--host={host}", f"--port={port}", "--protocol=TCP"])
            else:
                command.append(f"--socket={MYSQL_SOCKET}")
            for option, setting in (("--column-statistics", "0"), ("--set-gtid-purged", "OFF")):
                if option in help_result.stdout:
                    command.append(f"{option}={setting}")
            command.extend([database, *TABLE_NAMES])
            with tempfile.NamedTemporaryFile(dir=destination.parent, prefix="all_parts_",
                                             suffix=".tmp", delete=False) as stream:
                temporary_output = Path(stream.name)
                result = subprocess.run(command, stdout=stream, stderr=subprocess.PIPE,
                                        timeout=180, check=False)
            require(result.returncode == 0 and temporary_output.stat().st_size > 0,
                    "Dump failed; the previous SQL file was retained. Check your mysqldump credentials/version.")
            text = temporary_output.read_text(encoding="utf-8")
            # MariaDB's client-only sandbox directive is not supported by MySQL clients.
            text = re.sub(r"\A/\*M!999999.*?\*/\r?\n", "", text, count=1)
            require(not re.search(r"\bs\d{6,}\b|/home/s\d+", text, re.IGNORECASE),
                    "The dump contains an identifying student number; it was not published.")
            observed = Counter(re.findall(r"^INSERT INTO `([^`]+)`", text, re.MULTILINE))
            require(all(observed[table] == expected_counts[table] for table in TABLE_NAMES),
                    "Dump row counts differ from the verified import; the previous SQL file was retained.")
            temporary_output.write_text(text, encoding="utf-8")
            temporary_output.replace(destination)
    finally:
        if temporary_output is not None:
            temporary_output.unlink(missing_ok=True)
    return destination


def main(argv=None):
    global MYSQL_SOCKET, MYSQL_OPTION_FILE
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project-root", type=Path, default=PROJECT_ROOT)
    parser.add_argument("--part1-dir", type=Path)
    parser.add_argument("--part2-dir", type=Path)
    parser.add_argument("--part3-dir", type=Path)
    parser.add_argument("--part4-dir", type=Path)
    parser.add_argument("--dump-file", type=Path)
    parser.add_argument("--socket", default=os.environ.get("MYSQL_SOCKET", MYSQL_SOCKET))
    parser.add_argument("--host", default=os.environ.get("MYSQL_HOST"), help="Optional TCP host for an SSH tunnel.")
    parser.add_argument("--port", type=int, default=int(os.environ.get("MYSQL_PORT", "3306")))
    parser.add_argument("--check-files", action="store_true", help="Validate files without MySQL or API calls.")
    args = parser.parse_args(argv)
    root = args.project_root.expanduser()
    part1_dir = (args.part1_dir or root / "OP1_data/part1_data/final_data").expanduser()
    part2_dir = (args.part2_dir or root / "OP1_data/part2_data").expanduser()
    part3_dir = (args.part3_dir or root / "OP1_data/part3_data").expanduser()
    part4_dir = (args.part4_dir or root / "OP1_data/part4_data").expanduser()
    destination = (args.dump_file or root / "OP2_SQL/all_parts_sql/bdb_ica_all_parts.sql").expanduser()
    part1, part2 = read_part1_tables(part1_dir), read_part2_tables(part2_dir)
    extra = read_extra_tables(part3_dir, part4_dir)
    validate_relationships(part1, part2, extra)
    prepared = {PART1_TABLE_NAME: part1, PART2_TABLE_NAME: part2, **extra}
    expected_counts = {}
    for table in TABLE_NAMES:
        counts = [len(prepared[table][dataset]) for dataset in DATASETS]
        expected_counts[table] = sum(counts)
        print(f"{table}: development={counts[0]}, challenge={counts[1]}")
    if args.check_files:
        print("[OK] All TSVs and cross-part relationships checked; no MySQL/API calls made.")
        return
    MYSQL_SOCKET = args.socket
    MYSQL_OPTION_FILE = Path(os.environ.get("BDB_MYSQL_OPTION_FILE", "~/.my.cnf")).expanduser()
    with connect_mysql(args.host, args.port) as connection:
        with connection.cursor() as cursor:
            choose_database(connection, cursor)
            cursor.execute("SET SESSION sql_mode = CONCAT_WS(',', @@sql_mode, 'STRICT_ALL_TABLES')")
            connection.commit()
            prepare_schema(connection, cursor)
            load_and_verify(connection, cursor, prepared)
            database, username = connection.database, connection.user
    print("[OK] All nine tables committed after checking every stored value.")
    path = export_all(database, username, _FALLBACK_PASSWORD, destination, expected_counts,
                      args.host, args.port)
    print(f"[OK] Combined schema-and-data dump saved: {path}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n[ERROR] Cancelled.", file=sys.stderr)
        sys.exit(130)
    except Exception as error:
        print(f"[ERROR] {error}", file=sys.stderr)
        sys.exit(1)
