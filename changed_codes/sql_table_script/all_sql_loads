#!/usr/bin/env python3
"""Load every Part 1-4 TSV output into MySQL, then write the two mysqldump files.
"""
import csv
import os
import re
import subprocess
from getpass import getpass, getuser
from pathlib import Path

import mysql.connector

ROOT = Path(__file__).resolve().parents[2]          # repo root (~/BDB_ICA)
DATA = ROOT / "OP1_data"
OUT_DIR = ROOT / "OP2_SQL"
SOCKET = "/var/run/mysqld/mysqld.sock"
DATASETS = ("development", "challenge")
# Where each part's TSV files are; {d} is the list name.
PART_DIRS = {1: "part1_data/final_data/{d}", 2: "part2_data/{d}",
             3: "part3_data/{d}", 4: "part4_data/{d}"}
# Friendly names for the known files (used by the HTML script); others get p<part>_<file>.
NAMES = {"ncbi_gene_summary2": "p1_annotations", "ncbi_ortholog": "p2_orthologs",
         "p3_pair_summary": "p3_pair_summary",
         "local_ncbi_comparisons": "p4_local_ncbi_comparisons"}


def find_tables():
    """{table name: {dataset: tsv path}} for every TSV that exists."""
    tables = {}
    for part, folder in PART_DIRS.items():
        for dataset in DATASETS:
            for path in sorted((DATA / folder.format(d=dataset)).glob("*.tsv")):
                name = NAMES.get(path.stem, f"p{part}_{path.stem}")
                tables.setdefault(name, {})[dataset] = path
    return tables


def read_tsv(path, dataset):
    with path.open(encoding="utf-8-sig", newline="") as handle:
        reader = csv.reader(handle, delimiter="\t")
        header = next(reader)
        rows = [row for row in reader if row]
    for number, row in enumerate(rows, 1):
        if len(row) != len(header):
            raise ValueError(f"{path} row {number}: {len(row)} fields, header has {len(header)}")
    if "Dataset" in header:                          # Parts 3-4 already have it
        i = header.index("Dataset")
        header = header[:i] + header[i + 1:]
        rows = [row[:i] + row[i + 1:] for row in rows]
    if "Input_Row" not in header:                    # keep the input order for joins
        header = ["Input_Row"] + header
        rows = [[str(n)] + row for n, row in enumerate(rows, 1)]
    return ["Dataset"] + header, [[dataset] + row for row in rows]


def sql_type(values):
    """Simple types from the data: whole numbers, decimals, otherwise text."""
    values = [v for v in values if v != ""]
    if values and all(re.fullmatch(r"-?\d{1,18}", v) for v in values):
        return "BIGINT"
    if values and all(re.fullmatch(r"-?\d+(\.\d+)?([eE]-?\d+)?", v) for v in values):
        return "DOUBLE"
    return "LONGTEXT"


def load(cursor, table, files):
    header, rows = None, []
    for dataset, path in files.items():
        file_header, file_rows = read_tsv(path, dataset)
        if header and file_header != header:
            raise ValueError(f"{table}: development and challenge headers differ")
        header, rows = file_header, rows + file_rows
    types = [sql_type([row[i] for row in rows]) for i in range(len(header))]
    types[0] = "VARCHAR(20) NOT NULL"                # Dataset
    columns = ",\n  ".join(f"`{name}` {kind}" for name, kind in zip(header, types))
    cursor.execute(f"DROP TABLE IF EXISTS `{table}`")
    cursor.execute(f"CREATE TABLE `{table}` (\n  {columns}\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4")
    names = ", ".join(f"`{name}`" for name in header)
    marks = ", ".join(["%s"] * len(header))
    cursor.executemany(f"INSERT INTO `{table}` ({names}) VALUES ({marks})",
                       [[None if v == "" else v for v in row] for row in rows])
    cursor.execute(f"SELECT COUNT(*) FROM `{table}`")
    if cursor.fetchone()[0] != len(rows):
        raise ValueError(f"{table}: row count in MySQL differs from the files")
    print(f"{table}: {len(rows)} rows")


def dump(user, password, database, tables, b_number):
    env = dict(os.environ, MYSQL_PWD=password)
    base = ["mysqldump", "--no-defaults", f"--user={user}", f"--socket={SOCKET}",
            "--single-transaction", "--no-tablespaces", "--skip-comments", "--compact"]
    OUT_DIR.mkdir(exist_ok=True)
    for kind, option in (("schema", "--no-data"), ("data", "--no-create-info")):
        result = subprocess.run(base + [option, database, *tables], env=env,
                                capture_output=True, text=True)
        if result.returncode != 0:
            raise RuntimeError("mysqldump failed: " + result.stderr)
        path = OUT_DIR / f"{b_number}_{kind}.sql"
        path.write_text(result.stdout.replace(user, b_number), encoding="utf-8")
        print(f"Saved {path}")


def main():
    tables = find_tables()
    if not tables:
        raise SystemExit(f"No TSV files found under {DATA}")
    user = os.environ.get("MYSQL_USER") or getuser()
    password = getpass(f"MySQL password for {user}: ")
    database = input("Database name: ").strip()
    b_number = input("B number for the dump files (Enter for 'Bnumber'): ").strip() or "Bnumber"
    connection = mysql.connector.connect(user=user, password=password, database=database,
                                         unix_socket=SOCKET, charset="utf8mb4", autocommit=False)
    cursor = connection.cursor()
    try:
        cursor.execute("SET FOREIGN_KEY_CHECKS = 0")
        for table, files in tables.items():
            load(cursor, table, files)
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        cursor.execute("SET FOREIGN_KEY_CHECKS = 1")
        connection.close()
    dump(user, password, database, list(tables), b_number)


if __name__ == "__main__":
    main()
