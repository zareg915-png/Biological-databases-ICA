import os
import sys
from datetime import datetime
from getpass import getpass, getuser
from html import escape
from pathlib import Path
from urllib.parse import quote

DATASETS = ("development", "challenge")          # values of the Dataset column
OUTPUT_DIR = Path(os.environ.get("BDB_HTML_DIR", "~/HTML_script")).expanduser()
MYSQL_SOCKET = os.environ.get("MYSQL_SOCKET", "/var/run/mysqld/mysqld.sock")
MYSQL_DATABASE = os.environ.get("MYSQL_DATABASE", "")  # masked: set env or ~/.my.cnf
MY_CNF = Path("~/.my.cnf").expanduser()           # [client] user/password/database
MAX_TISSUES_SHOWN = 4                             # differing tissues listed per row

# One table per data source, as loaded by the Part 1-4 loader scripts.
TABLES = dict(annotation="p1_annotations", ortholog="p2_orthologs",
              gene="p3_gene_status", protein="p3_uniprot", pair="p3_pair_summary",
              tissue="p3_tissue_comparison", local="p4_local_ncbi_comparisons")


# One row per human input x mouse ortholog. Many-valued data (UniProt entries,
# tissues) is collapsed in derived tables first, so joining them cannot
# multiply rows. "<=>" is MySQL's NULL-safe equals: inputs without a mouse
# ortholog still meet their (empty) pair summary row.
SUMMARY_SQL = """
SELECT a.Input_Row, a.Query_Symbol, a.Resolution_Status, a.Resolution_Note,
       a.Gene_ID, a.Official_Symbol, a.Official_Name, a.Chromosome, a.Map_Location,
       a.ENSG_IDs, h.Gene_Type AS Human_Gene_Type,
       (SELECT MIN(d.Input_Row) FROM {annotation} d
         WHERE d.Dataset = a.Dataset AND d.Gene_ID = a.Gene_ID) AS First_Input,
       o.Mouse_Gene_ID, o.Mouse_Symbol, o.Mouse_Official_Name,
       o.Mouse_Ensembl_Gene_ID, o.Mouse_Ortholog_Count, o.Mapping_Status, o.Mapping_Note,
       hp.Accessions AS Human_UniProt, hp.N_Reviewed AS Human_Reviewed,
       mp.Accessions AS Mouse_UniProt, mp.N_Reviewed AS Mouse_Reviewed,
       s.GO_MF_Jaccard, s.GO_BP_Jaccard, s.GO_CC_Jaccard, s.Location_Jaccard,
       JSON_LENGTH(s.GO_MF_Shared_IDs) AS GO_MF_Shared,
       s.GO_MF_Human_Count + s.GO_MF_Mouse_Count - JSON_LENGTH(s.GO_MF_Shared_IDs) AS GO_MF_Union,
       JSON_LENGTH(s.GO_BP_Shared_IDs) AS GO_BP_Shared,
       s.GO_BP_Human_Count + s.GO_BP_Mouse_Count - JSON_LENGTH(s.GO_BP_Shared_IDs) AS GO_BP_Union,
       JSON_LENGTH(s.GO_CC_Shared_IDs) AS GO_CC_Shared,
       s.GO_CC_Human_Count + s.GO_CC_Mouse_Count - JSON_LENGTH(s.GO_CC_Shared_IDs) AS GO_CC_Union,
       JSON_LENGTH(s.Location_Shared_IDs) AS Location_Shared,
       s.Location_Human_Count + s.Location_Mouse_Count
         - JSON_LENGTH(s.Location_Shared_IDs) AS Location_Union,
       s.Comparable_Tissue_Count, s.Concordant_Tissue_Count,
       s.Expression_Call_Agreement, s.Present_Tissue_Jaccard,
       t.Differing_Tissues, t.N_Differing,
       l.Comparison_Status AS Local_Comparison, l.Local_Status, l.Differences AS Local_Differences,
       l.Missing_Fields AS Local_Missing,
       CASE WHEN a.Resolution_Status <> 'resolved' THEN 'input not resolved to a human gene'
            WHEN o.Mouse_Gene_ID IS NULL THEN 'no mouse ortholog returned by NCBI'
            WHEN 'not_applicable_gene_type' IN (h.UniProt_Status, m.UniProt_Status)
                 THEN 'non-coding gene: no protein expected'
            WHEN s.Protein_Comparison_Status <> 'annotation_overlap_only'
                 THEN REPLACE(s.Protein_Comparison_Status, '_', ' ')
       END AS Protein_Note,
       CASE WHEN a.Resolution_Status <> 'resolved' THEN 'input not resolved to a human gene'
            WHEN o.Mouse_Gene_ID IS NULL THEN 'no mouse ortholog returned by NCBI'
            WHEN s.Expression_Comparison_Status <> 'comparable'
                 THEN REPLACE(s.Expression_Comparison_Status, '_', ' ')
       END AS Expression_Note
FROM {annotation} a
LEFT JOIN {ortholog} o ON o.Dataset = a.Dataset AND o.Input_Row = a.Input_Row
LEFT JOIN {pair} s     ON s.Dataset = a.Dataset AND s.Input_Row = a.Input_Row
                      AND s.Mouse_Gene_ID <=> o.Mouse_Gene_ID
LEFT JOIN {gene} h     ON h.Dataset = a.Dataset AND h.Species = 'human' AND h.Gene_ID = a.Gene_ID
LEFT JOIN {gene} m     ON m.Dataset = a.Dataset AND m.Species = 'mouse' AND m.Gene_ID = o.Mouse_Gene_ID
LEFT JOIN (SELECT Dataset, Species, Gene_ID, SUM(Reviewed = 1) AS N_Reviewed,
                  GROUP_CONCAT(UniProt_Accession ORDER BY Reviewed DESC, UniProt_Accession) AS Accessions
             FROM {protein} WHERE Selected = 1 GROUP BY Dataset, Species, Gene_ID) hp
       ON hp.Dataset = a.Dataset AND hp.Species = 'human' AND hp.Gene_ID = a.Gene_ID
LEFT JOIN (SELECT Dataset, Species, Gene_ID, SUM(Reviewed = 1) AS N_Reviewed,
                  GROUP_CONCAT(UniProt_Accession ORDER BY Reviewed DESC, UniProt_Accession) AS Accessions
             FROM {protein} WHERE Selected = 1 GROUP BY Dataset, Species, Gene_ID) mp
       ON mp.Dataset = a.Dataset AND mp.Species = 'mouse' AND mp.Gene_ID = o.Mouse_Gene_ID
LEFT JOIN (SELECT Dataset, Input_Row, Mouse_Gene_ID,
                  SUM(Comparison_Status = 'different_call') AS N_Differing,
                  GROUP_CONCAT(CASE WHEN Comparison_Status = 'different_call'
                               THEN CONCAT(COALESCE(Tissue_Name, Tissue_ID),
                                           ' (H ', Human_Call, ' / M ', Mouse_Call, ')') END
                               ORDER BY Tissue_Name SEPARATOR '; ') AS Differing_Tissues
             FROM {tissue} GROUP BY Dataset, Input_Row, Mouse_Gene_ID) t
       ON t.Dataset = a.Dataset AND t.Input_Row = a.Input_Row AND t.Mouse_Gene_ID <=> o.Mouse_Gene_ID
LEFT JOIN {local} l    ON l.Dataset = a.Dataset AND l.Input_Row = a.Input_Row
WHERE a.Dataset = %(dataset)s
ORDER BY a.Input_Row, o.Mouse_Gene_ID
""".format(**TABLES)

# Headline numbers for the top of each page, also computed by SQL.
STATS_SQL = """
SELECT COUNT(*) AS inputs,
       SUM(a.Resolution_Status = 'resolved') AS resolved,
       COUNT(DISTINCT a.Gene_ID) AS unique_genes,
       (SELECT COUNT(DISTINCT Input_Row) FROM {ortholog}
         WHERE Dataset = %(dataset)s AND Mouse_Gene_ID IS NOT NULL) AS with_mouse,
       (SELECT COUNT(*) FROM {pair} WHERE Dataset = %(dataset)s
           AND Protein_Comparison_Status = 'annotation_overlap_only') AS protein_pairs,
       (SELECT COUNT(*) FROM {pair} WHERE Dataset = %(dataset)s
           AND Expression_Comparison_Status = 'comparable') AS expression_pairs,
       (SELECT AVG(GO_BP_Jaccard) FROM {pair} WHERE Dataset = %(dataset)s) AS mean_bp,
       (SELECT AVG(Expression_Call_Agreement) FROM {pair} WHERE Dataset = %(dataset)s) AS mean_expr,
       (SELECT SUM(Comparison_Status = 'all_fields_agree') FROM {local}
         WHERE Dataset = %(dataset)s) AS local_agree
FROM {annotation} a WHERE a.Dataset = %(dataset)s
""".format(**TABLES)

# Readable explanations for the MySQL errors most likely to occur.
DB_ERROR_HINTS = {
    1045: "access denied - check user/password in ~/.my.cnf",
    1049: "unknown database - set MYSQL_DATABASE to your personal database",
    1054: "missing column - reload the Part 1-4 tables with the current loaders",
    1146: "missing table - run the Part 1-4 MySQL loaders first",
    2002: "cannot reach the MySQL socket - run this on bioinfmsc9",}


def connect():
    """Connect over the bioinfmsc9 socket; ~/.my.cnf first, else prompt."""
    import mysql.connector
    settings = dict(unix_socket=MYSQL_SOCKET, charset="utf8mb4")
    if MY_CNF.is_file():
        settings.update(option_files=str(MY_CNF), option_groups=["client"])
    else:
        settings.update(user=getuser(), password=getpass("MySQL password: "))
    if MYSQL_DATABASE:
        settings["database"] = MYSQL_DATABASE
    connection = mysql.connector.connect(**settings)
    if not connection.database:
        connection.database = input("Your personal MySQL database: ").strip()
    return connection


def fetch(connection, sql, dataset):
    with connection.cursor(dictionary=True) as cursor:
        cursor.execute(sql, {"dataset": dataset})
        return cursor.fetchall()



def e(value):
    return escape("" if value is None else str(value))


def link(url, text):
    return f'<a href="{e(url)}" target="_blank">{e(text)}</a>'


def ncbi(gene_id, symbol):
    return link("https://www.ncbi.nlm.nih.gov/gene/" + quote(str(gene_id)), symbol)


def tag(text, tone=""):
    return f'<span class="tag {tone}">{e(text)}</span>'


def na(reason):
    return f'<span class="na">N/A: {e(reason)}</span>'


def small(text):
    return f'<div class="small">{e(text)}</div>' if text else ""


def bar(score, shared=None, union=None, label=""):
    """Show a 0-1 score as a number plus a bar, so a column can be scanned."""
    if score is None:
        return f'<div class="metric">{e(label)} {na("missing annotation")}</div>'
    score = float(score)
    counts = f' <span class="small">({shared}/{union})</span>' if union else ""
    return (f'<div class="metric"><span class="lab">{e(label)}</span> <b>{score:.2f}</b>{counts}'
            f'<div class="bar"><span style="width:{score * 100:.0f}%"></span></div></div>')



def input_cell(r):
    html = f'<b>{e(r["Query_Symbol"])}</b> <span class="small">#{r["Input_Row"]}</span><br>'
    if r["Resolution_Status"] != "resolved":
        return html + tag("unresolved", "bad") + small(r["Resolution_Note"])
    html += tag("resolved", "ok")
    if r["First_Input"] != r["Input_Row"]:
        html += small(f'Same gene as input #{r["First_Input"]} (synonym or Ensembl ID).')
    return html


def human_cell(r):
    if not r["Gene_ID"]:
        return na("no NCBI Gene record")
    location = " ".join(str(x) for x in ("chr" + str(r["Chromosome"] or "?"), r["Map_Location"]) if x)
    return (ncbi(r["Gene_ID"], r["Official_Symbol"]) + small(r["Official_Name"])
            + small(f'Gene ID {r["Gene_ID"]} | {location}')
            + small(str(r["Human_Gene_Type"] or "").replace("_", " ").lower()))


def mouse_cell(r):
    if not r["Mouse_Gene_ID"]:
        return na(str(r["Mapping_Status"] or "not assessed").replace("_", " "))
    count = r["Mouse_Ortholog_Count"] or 1
    return (ncbi(r["Mouse_Gene_ID"], r["Mouse_Symbol"]) + small(r["Mouse_Official_Name"])
            + small(f'Gene ID {r["Mouse_Gene_ID"]}')
            + (tag(f"1 of {count} mouse orthologs", "warn") if count > 1 else ""))


def uniprot_cell(r):
    if r["Protein_Note"] and not r["Human_UniProt"]:
        return na(r["Protein_Note"])
    lines = []
    for species in ("Human", "Mouse"):
        accessions = (r[species + "_UniProt"] or "").split(",")
        if not accessions[0]:
            lines.append(f"{species}: " + na("no entry"))
            continue
        links = ", ".join(link("https://www.uniprot.org/uniprotkb/" + quote(a), a) for a in accessions)
        lines.append(f'{species}: {links} <span class="small">'
                     f'({int(r[species + "_Reviewed"] or 0)}/{len(accessions)} Swiss-Prot)</span>')
    return "<br>".join(lines)


def protein_cells(r):
    """Two cells: GO function overlap and localisation overlap."""
    if r["Protein_Note"]:
        return f'<td colspan="2">{na(r["Protein_Note"])}</td>'
    function = (bar(r["GO_MF_Jaccard"], r["GO_MF_Shared"], r["GO_MF_Union"], "MF")
                + bar(r["GO_BP_Jaccard"], r["GO_BP_Shared"], r["GO_BP_Union"], "BP"))
    location = (bar(r["GO_CC_Jaccard"], r["GO_CC_Shared"], r["GO_CC_Union"], "GO CC")
                + bar(r["Location_Jaccard"], r["Location_Shared"], r["Location_Union"], "UniProt"))
    return f"<td>{function}</td><td>{location}</td>"


def expression_cell(r):
    bgee = [link("https://www.bgee.org/gene/" + quote(gid.strip()), label)
            for gid, label in ((r["ENSG_IDs"], "human"), (r["Mouse_Ensembl_Gene_ID"], "mouse"))
            if gid and "," not in str(gid)]
    links = '<div class="small">Bgee: ' + " | ".join(bgee) + "</div>" if bgee else ""
    if r["Expression_Note"]:
        return na(r["Expression_Note"]) + links
    n, agree = r["Comparable_Tissue_Count"], r["Concordant_Tissue_Count"]
    html = bar(r["Expression_Call_Agreement"], agree, n, "Call agreement")
    html += bar(r["Present_Tissue_Jaccard"], label="Present-tissue J")
    if r["N_Differing"]:
        shown = str(r["Differing_Tissues"]).split("; ")
        extra = len(shown) - MAX_TISSUES_SHOWN
        html += small(f'{r["N_Differing"]} differ: ' + "; ".join(shown[:MAX_TISSUES_SHOWN])
                      + (f" (+{extra} more)" if extra > 0 else ""))
    return html + links


def local_cell(r):
    status = r["Local_Comparison"]
    if not status or status == "not_assessed":
        return na(str(r["Local_Status"] or "not assessed").replace("_", " "))
    html = tag("agrees with NCBI", "ok") if status == "all_fields_agree" else \
        tag(status.replace("_", " "), "warn")
    return html + small(r["Local_Differences"]) + small(
        "Missing: " + r["Local_Missing"] if r["Local_Missing"] else "")



HEADERS = ("Input", "Human gene (NCBI)", "Mouse ortholog (NCBI)", "UniProt entries",
           "GO function overlap (Jaccard)", "Localisation overlap (Jaccard)",
           "Bgee tissue expression", "Local API vs NCBI")

STYLE = """
body{font-family:Arial,Helvetica,sans-serif;font-size:11pt;margin:20px;color:#222}
table{border-collapse:collapse;width:100%}
th,td{border:1px solid #999;padding:6px;vertical-align:top;text-align:left}
th{background:#2c4a6b;color:#fff;position:sticky;top:0}
tr.first td{border-top:2px solid #444}
.small{font-size:10pt;color:#555}
.na{font-size:10pt;color:#888;font-style:italic}
.tag{font-size:9.5pt;padding:1px 5px;border-radius:3px;background:#eee}
.ok{background:#d6f0d6}.warn{background:#fff0c2}.bad{background:#f8d4d4}
.metric{margin-bottom:5px}.lab{display:inline-block;min-width:3.5em}
.bar{height:6px;background:#e3e3e3;width:120px}.bar span{display:block;height:6px;background:#3a7bbf}
.stats span{display:inline-block;margin:0 14px 8px 0}
"""

LEGEND = """
<h3>How to read this table</h3>
<ul>
<li>One row per human input and mouse ortholog pair. Inputs that resolve to the same human gene
(e.g. a synonym or an Ensembl ID) are kept as separate rows and flagged.</li>
<li><b>Jaccard</b> = shared terms / all terms across human and mouse (0 = no overlap, 1 = identical).
Brackets give shared/union counts. MF = molecular function, BP = biological process,
CC = cellular component; UniProt = UniProt subcellular-location terms.</li>
<li><b>Call agreement</b> = tissues where Bgee gives the same present/absent call in both species,
over tissues with an eligible call in both. <b>Present-tissue J</b> = tissues present in both /
tissues present in either.</li>
<li><b>Local API vs NCBI</b> compares Gene ID, symbol, name, chromosome, locus and aliases from the
course web service with the NCBI record.</li>
<li><b>N/A</b> always states why a value is missing (unresolved input, no ortholog, non-coding gene,
missing annotation). It never means zero.</li>
</ul>
<p class="small">Sources: NCBI Gene and Datasets orthologs, UniProtKB, Bgee, local course API
(bioinfmsc6). Gene symbols and accessions link to the source records.</p>
"""

def render(dataset, rows, stats):
    s = stats
    mean = lambda v: "N/A" if v is None else f"{float(v):.2f}"
    stat_html = "".join(f"<span><b>{e(v)}</b> {e(k)}</span>" for k, v in (
        ("inputs", s["inputs"]), ("resolved", s["resolved"]), ("unique human genes", s["unique_genes"]),
        ("with mouse ortholog", s["with_mouse"]), ("protein pairs compared", s["protein_pairs"]),
        ("expression pairs compared", s["expression_pairs"]), ("mean GO BP Jaccard", mean(s["mean_bp"])),
        ("mean expression agreement", mean(s["mean_expr"])), ("local API agree", s["local_agree"] or 0)))

    group_size = {}
    for r in rows:
        group_size[r["Input_Row"]] = group_size.get(r["Input_Row"], 0) + 1
    body, previous = [], None
    for r in rows:
        first = r["Input_Row"] != previous
        previous = r["Input_Row"]
        span = f' rowspan="{group_size[r["Input_Row"]]}"'
        cells = f"<td{span}>{input_cell(r)}</td><td{span}>{human_cell(r)}</td>" if first else ""
        cells += f"<td>{mouse_cell(r)}</td><td>{uniprot_cell(r)}</td>{protein_cells(r)}"
        cells += f"<td>{expression_cell(r)}</td>"
        cells += f"<td{span}>{local_cell(r)}</td>" if first else ""
        body.append(f'<tr class="{"first" if first else ""}">{cells}</tr>')

    title = f"Human vs mouse ortholog comparison: {dataset} gene list"
    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>{e(title)}</title><style>{STYLE}</style></head>
<body>
<h2>{e(title)}</h2>
<p class="small">Generated {datetime.now():%Y-%m-%d %H:%M} from MySQL tables
{e(", ".join(TABLES.values()))}.</p>
<div class="stats">{stat_html}</div>
<table>
<thead><tr>{"".join(f"<th>{h}</th>" for h in HEADERS)}</tr></thead>
<tbody>
{chr(10).join(body)}
</tbody></table>
{LEGEND}
<details><summary class="small">SQL query that built this table</summary>
<pre class="small">{e(SUMMARY_SQL.strip())}</pre></details>
</body></html>
"""

def main():
    chosen = sys.argv[1:] or DATASETS
    unknown = set(chosen) - set(DATASETS)
    if unknown:
        sys.exit(f"[ERROR] Unknown list {', '.join(unknown)}; choose from {', '.join(DATASETS)}.")
    try:
        import mysql.connector
    except ImportError:
        sys.exit("[ERROR] Install the connector: python3 -m pip install mysql-connector-python")

    try:
        connection = connect()
    except mysql.connector.Error as error:
        sys.exit(f"[ERROR] MySQL connection failed: {DB_ERROR_HINTS.get(error.errno, error.msg)}")

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    try:
        for dataset in chosen:
            rows = fetch(connection, SUMMARY_SQL, dataset)
            if not rows:
                print(f"[WARN] No rows for '{dataset}' in {TABLES['annotation']}; page skipped.")
                continue
            stats = fetch(connection, STATS_SQL, dataset)[0]
            out = OUTPUT_DIR / f"{dataset}_summary_table.html"
            out.write_text(render(dataset, rows, stats), encoding="utf-8")
            print(f"[INFO] {dataset}: {stats['inputs']} inputs, {len(rows)} table rows -> {out}")
    except mysql.connector.Error as error:
        sys.exit(f"[ERROR] Query failed: {DB_ERROR_HINTS.get(error.errno, error.msg)}")
    finally:
        connection.close()

if __name__ == "__main__":
    main()
