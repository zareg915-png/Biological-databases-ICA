
import scripts.ConnecttoNCBI_SRT as ncbi_gene
import scripts.ConnecttoString as con_string
import scripts.OrthologMap3_SRT as ncbi_orth
import scripts.ConnecttoDatabase as connect_db

def writeHTMLtable(data_final, file_out="final_html_table.html"):

    #open a file for output
    with open(file_out,'w+') as f:

        f.write("<HTML><HEAD></HEAD><BODY>\n")
        f.write("<TABLE border=\"1\">\n")
        f.write("<TR>\n")

        # labels
        for labels in data_final.columns.values:
            f.write("<TH>"+ labels+ "</TH>")
        f.write("</TR>\n")

        # Iterate the table- row wise per column
        for i in range(len(data_final)):
            row = data_final.iloc[i]
            f.write("<TR>")
            for index in data_final.columns.values:
                f.write("<TD>" + str(row[index])+ "</TD>")

            f.write("</TR>\n")
        f.write("</TABLE>\n")
        f.write("</BODY></HTML>\n")

        print("[INFO] Written html table to: "+file_out)


def main():
    print("#########################################################")
    print("#                                                       #")
    print("#  ICA Example S.Tomlinson Nov 2026                     #")
    print("#                                                       #")
    print("#########################################################")

    #set the genes to query
    gene_list = [
        "GRIN1",
        "GRIN2A",
        "GRIN2B",
        "GRIN2C",
        "GRIN2D",
        "GRIN3A",
        "GRIN3B",
        "GRIA1",
        "GRIA2",
        "GRIA3 ",
    ]

    #get the results from NCBI Gene Table
    print("[INFO]Connecting to the NCBI for the Gene Table")
    ncbi_results_file="ncbi_gene_summary2"
    ncbi_results_table=ncbi_gene.connect_ncbi_gene_info(gene_list,ncbi_results_file)

    #get the results for the Ortholog table
    print("[INFO]Connecting to the Ortholog Table")
    ncbi_ortholog_file = "ncbi_ortholog"
